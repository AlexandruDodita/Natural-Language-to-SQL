# Oracle connection (required)
# ORACLE_LIB_DIR is OPTIONAL. Leave it unset to use python-oracledb thin mode,
# which needs no Instant Client and works against Oracle Database 12.1+ (this
# is what the containerised Oracle Free setup uses). Set it to an Instant
# Client directory only if you specifically need thick-mode features.
# ORACLE_LIB_DIR=C:\path\to\instantclient_23_0
ORACLE_USER=your_db_user
ORACLE_PASSWORD=your_db_password
ORACLE_HOST=your_db_host
ORACLE_PORT=your_db_port
ORACLE_SERVICE_NAME=your_db_service_name

# Schema whose tables are exposed (optional, defaults to ORACLE_USER).
# Set this to the schema owner when connecting as a dedicated read-only user
# created by scripts/create_readonly_user.sql.
# ORACLE_TARGET_SCHEMA=

# MCP server auth (required) - shared bearer token clients must send as
# `Authorization: Bearer <token>`. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_AUTH_TOKEN=

# MCP server identity and binding (optional, defaults shown). The token travels
# in cleartext over HTTP - only bind a non-loopback address behind TLS.
# MCP_SERVER_NAME=oracle
# MCP_HOST=127.0.0.1
# MCP_PORT=8000

# Query guards (optional, defaults shown)
# Comma-separated table names hidden from list_tables/describe_table/run_query.
# TABLE_DENYLIST=
# MAX_ROWS_HARD_CAP=1000
# QUERY_TIMEOUT_SECONDS=30

# Response shaping (optional, defaults shown). Protects the MCP client's
# context window: string cells are truncated at MAX_CELL_CHARS, and trailing
# rows are dropped once a response's JSON exceeds MAX_RESPONSE_CHARS.
# MAX_CELL_CHARS=2000
# MAX_RESPONSE_CHARS=200000

# Audit log (optional, default shown)
# AUDIT_LOG_PATH=logs/audit.log
