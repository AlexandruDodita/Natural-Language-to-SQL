# Copy to .env (or export directly) before running server.py / client_harness.py.

# Connection string for the car_rental DB's read-only role. Defaults to the
# readonly_user credentials seeded by test_app_db/init/03_readonly_user.sql.
# Host/port here assume you're running OUTSIDE docker-compose, hitting the
# host-mapped port (5434 -> test_app_db's internal 5432). If this server
# runs as its own docker-compose service instead, point it at
# postgresql://readonly_user:readonly_pass@test_app_db:5432/car_rental
DATABASE_URL=postgresql://readonly_user:readonly_pass@localhost:5434/car_rental

# Safety limits enforced in-process (in addition to the DB-level read-only
# role and session-level default_transaction_read_only).
MAX_ROWS=100
STATEMENT_TIMEOUT_MS=5000

# Only needed for client_harness.py (the LLM-driven evaluation harness) —
# server.py / db.py never read these. Matches rag-service's env vars.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Optional: max tool-call rounds before client_harness.py gives up on a
# question and reports an error instead of looping forever.
MCP_HARNESS_MAX_ROUNDS=8
